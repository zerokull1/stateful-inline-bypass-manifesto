#include <linux/bpf.h>
#include <linux/if_ether.h>
#include <linux/ip.h>
#include <linux/tcp.h>
#include <bpf/bpf_helpers.h>

SEC("xdp")
int xdp_filter_null_bypass(struct xdp_md *ctx) {
    void *data_end = (void *)(long)ctx->data_end;
    void *data     = (void *)(long)ctx->data;

    // Парсинг L2 (Ethernet)
    struct ethhdr *eth = data;
    if ((void *)(eth + 1) > data_end)
        return XDP_PASS;

    // Проверяем, что это IPv4
    if (eth->h_proto != __constant_htons(ETH_P_IP))
        return XDP_PASS;

    // Парсинг L3 (IP)
    struct iphdr *iph = (void *)(eth + 1);
    if ((void *)(iph + 1) > data_end)
        return XDP_PASS;

    // Нас интересует только TCP
    if (iph->protocol != IPPROTO_TCP)
        return XDP_PASS;

    // Парсинг L4 (TCP)
    struct tcphdr *th = (void *)((__u32 *)iph + iph->ihl);
    if ((void *)(th + 1) > data_end)
        return XDP_PASS;

    // ФИЗИКА ДЕТЕКЦИИ: проверка на Null-пакет (все флаги сброшены в 0)
    // В реальном conntrack пакет пролетел бы по Fast-Path, но XDP видит его здесь
    if (th->syn == 0 && th->ack == 0 && th->fin == 0 && th->rst == 0 && th->psh == 0 && th->urg == 0) {
        // Защитная реакция: Дропаем аномальный пакет на уровне сетевой карты
        return XDP_DROP; 
    }

    return XDP_PASS;
}

